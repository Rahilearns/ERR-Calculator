# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# Port the API listens on
PORT=4000

# Secret used to sign login tokens (JWT). Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid
TOKEN_TTL=12h

# Which website origins may call this API (comma-separated). Include your live site and,
# for local testing, the dev server. "*" allows any origin (fine for local dev only).
CORS_ORIGIN=https://rahilearns.github.io,http://localhost:5508,http://127.0.0.1:5508

# The first admin account is created automatically on startup from these values.
# Log in with this CIF + password to reach the admin portal. Change the password after first login.
ADMIN_CIF=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=admin@idlc.com

# Registration rules
# Only allow emails ending in this domain (leave blank to allow any valid email).
ALLOWED_EMAIL_DOMAIN=idlc.com
# Minimum password length
MIN_PASSWORD_LENGTH=8
